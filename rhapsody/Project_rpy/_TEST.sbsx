			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">%0D
//initialisation driver CAN%0D
    if ((handle[0] = CanOpenDriver(0, 0)) == -1)%0D
    {%0D
        printf(&quot;\nOpen Port 0 Failed!!&quot;);%0D
        return -1;%0D
	}%0D
num_pc=numPC;%0D
num_tapis = numMaq;%0D
id_maq_pc = (num_tapis*16)+num_pc ;%0D
printf (&quot;PC %25d -&gt; choix Tapis %25d \n&quot;, num_pc, num_tapis);%0D
 %0D
%0D
printf (&quot;Initialisation CAN.....&quot;);%0D
init_can(id_maq_pc);%0D
%0D
_7841_Write(handle[0],1,0x04);%0D
_7841_Write(handle[0],1,0x04);%0D
%0D
printf (&quot;SUCCESS\n&quot;);%0D
%0D
printf (&quot;Reinitialisation du tapis...\n&quot;);%0D
	/*bit[0]=0;%0D
	bit[1]=0;%0D
	bit[2]=0;%0D
	bit[3]=0;%0D
	bit[4]=0;%0D
	bit[5]=0;%0D
	bit[6]=0;*/%0D
	%0D
	//int trame_sortie=0;%0D
	      %0D
	commandes.mava = 0; %0D
	commandes.mara = 0; %0D
%0D
	commandes.mavb = 0; %0D
	commandes.marb = 0; %0D
	%0D
	commandes.mavc = 0; %0D
	commandes.marc = 0; %0D
%0D
    commandes.ev = 0; %0D
        %0D
    send_mess(commandes);%0D
          %0D
 connected = true;%0D
 %0D
 printf (&quot;connexion ok \n&quot;);%0D
 return 0;</_bodyData>
			</IBody>
			</_itsBody>
