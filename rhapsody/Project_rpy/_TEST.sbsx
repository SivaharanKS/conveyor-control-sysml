			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">     //reset%0D
	_7841_Write(handle[0],0,0x01); %0D
	%0D
	//CONFIGURATION%0D
	//CAN A%0D
	_7841_Write(handle[0],30,0x00);%0D
	%0D
	_7841_Write(handle[0],31,0x00);%0D
%0D
	_7841_Write(handle[0],8,0xFA);%0D
	//config BTR  50 kbis/s%0D
	_7841_Write(handle[0],6,0x07); //modif%0D
	%0D
	_7841_Write(handle[0],7,0x5c); // modif%0D
%0D
	//Config du mask%0D
	_7841_Write(handle[0],5,0x00);%0D
	_7841_Write(handle[0],4,id); // modif%0D
%0D
	//CAN A%0D
	_7841_Write(handle[0],30,0x00);%0D
	%0D
	_7841_Write(handle[0],31,0x00);%0D
	//relancer la carte%0D
	_7841_Write(handle[0],0,0x00);   %0D
	                                 %0D
	_7841_Write(handle[0],1,0x04);%0D
	_7841_Write(handle[0],1,0x04);      %0D
	%0D
        %0D
        %0D
        </_bodyData>
			</IBody>
			</_itsBody>
