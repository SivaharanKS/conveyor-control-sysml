			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">if(((_7841_Read(handle[0],2))&amp;0x01)==1){%0D
		//printf(&quot;Dans le if \n&quot;);%0D
		octets_entree[0]=_7841_Read(handle[0],22);%0D
		octets_entree[1]=_7841_Read(handle[0],23);%0D
		octets_entree[2]=_7841_Read(handle[0],24);%0D
		%0D
		_7841_Write(handle[0],1,0x04);%0D
		%0D
		%0D
		//printf(&quot;Etat entrees\n\n&quot;);		%0D
		//printf(&quot;Debut cycle A :  %25d\n&quot;,trame_entree[0]&amp;0x01);		%0D
		capteurs-&gt;dca = octets_entree[0]&amp;0x01;%0D
		%0D
		//printf(&quot;Debut cycle B :  %25d\n&quot;,(trame_entree[0]&amp;0x02)/2);%0D
		capteurs-&gt;dcb = (octets_entree[0]&amp;0x02)/2;%0D
				%0D
		//printf(&quot;Debut tapis A :  %25d\n&quot;,(trame_entree[0]&amp;0x04)/4);%0D
		capteurs-&gt;deba = (octets_entree[0]&amp;0x04)/4;		%0D
				%0D
		//printf(&quot;Milieu tapis A :  %25d\n&quot;,(trame_entree[0]&amp;0x08)/8);%0D
		capteurs-&gt;mia = (octets_entree[0]&amp;0x08)/8;		%0D
		//if ((*entrees).Valeurs.mia==1) printf(&quot;#######      MIA        ###################### \n&quot;);%0D
				%0D
		//printf(&quot;Fin tapis A :  %25d\n&quot;,trame_entree[1]&amp;0x01);%0D
		capteurs-&gt;fina = octets_entree[1]&amp;0x01;		%0D
		%0D
		//printf(&quot;Debut tapis B :  %25d\n&quot;,(trame_entree[1]&amp;0x02)/2);%0D
		capteurs-&gt;debb = (octets_entree[1]&amp;0x02)/2;		%0D
		%0D
		//printf(&quot;Milieu Tapis B :  %25d\n&quot;,(trame_entree[1]&amp;0x04)/4);%0D
		capteurs-&gt;mib = (octets_entree[1]&amp;0x04)/4;		%0D
		%0D
		//printf(&quot;Fin tapis B :  %25d\n&quot;,(trame_entree[1]&amp;0x08)/8);%0D
		capteurs-&gt;finb = (octets_entree[1]&amp;0x08)/8;		%0D
		%0D
		//printf(&quot;Debut tapis C :  %25d\n&quot;,trame_entree[2]&amp;0x01);%0D
		capteurs-&gt;debc = octets_entree[2]&amp;0x01;		%0D
		%0D
		//printf(&quot;Fin tapis C :  %25d\n&quot;,(trame_entree[2]&amp;0x02)/2);%0D
		capteurs-&gt;finc = (octets_entree[2]&amp;0x02)/2;		%0D
		%0D
		//printf(&quot;Verin vers A :  %25d\n&quot;,(trame_entree[2]&amp;0x04)/4);%0D
		capteurs-&gt;versa = (octets_entree[2]&amp;0x04)/4;		%0D
		%0D
		//printf(&quot;Verin vers B :  %25d\n&quot;,(trame_entree[2]&amp;0x08)/8);%0D
	    capteurs-&gt;versb = (octets_entree[2]&amp;0x08)/8;		%0D
		%0D
				return(0);%0D
	}%0D
		else %0D
		    %0D
		return(-1);  %0D
		%0D
		%0D
		</_bodyData>
