			<_name type="a">connect_to_maq</_name>
			<_modifiedTimeWeak type="a">12.5.2025::0:18:21</_modifiedTimeWeak>
			<_modifiedTime type="a">12.5.2025::0:18:21</_modifiedTime>
			<_lastID type="a">2</_lastID>
