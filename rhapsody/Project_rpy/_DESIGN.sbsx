			<_name type="a">connect_to_maq</_name>
			<_modifiedTimeWeak type="a">12.5.2025::11:43:42</_modifiedTimeWeak>
			<_modifiedTime type="a">12.5.2025::11:43:42</_modifiedTime>
			<_lastID type="a">2</_lastID>
			<_virtual type="a">1</_virtual>
			<Args type="c">
				<IRPYRawContainer type="e">
				</IRPYRawContainer>
			</Args>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">int</_hname>
					<_hid type="a">GUID 6024c6ab-fe9e-402e-954f-27aca6d3b5e4</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a"> printf(&quot;\n coonecting to maq reel...&quot;);%0D
//initialisation driver CAN%0D
    if ((handle[0] = CanOpenDriver(0, 0)) == -1)%0D
    {%0D
        printf(&quot;\nOpen Port 0 Failed!!&quot;);%0D
        return -1;%0D
	}%0D
num_pc=_ID_PC_;%0D
num_tapis = _NUM_MAQ_;%0D
id_maq_pc = (num_tapis*16)+num_pc ;%0D
printf (&quot;PC %25d -&gt; choix Tapis %25d \n&quot;, num_pc, num_tapis);%0D
 %0D
%0D
printf (&quot;Initialisation CAN.....&quot;);%0D
init_com();%0D
%0D
_7841_Write(handle[0],1,0x04);%0D
_7841_Write(handle[0],1,0x04);%0D
%0D
printf (&quot;SUCCESS\n&quot;);%0D
%0D
reset_commandes();%0D
          %0D
connected = true;%0D
reset_commandes();%0D
printf (&quot;connexion ok \n&quot;);%0D
return 1;</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
		<IPrimitiveOperation type="e">
			<_id type="a">GUID cdffbc46-6dbc-4c51-8e36-91b50b410d3a</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">init_com</_name>
			<_modifiedTimeWeak type="a">12.2.2025::9:5:14</_modifiedTimeWeak>
			<_modifiedTime type="a">12.2.2025::9:5:14</_modifiedTime>
			<_lastID type="a">1</_lastID>
			<_virtual type="a">1</_virtual>
			<Args type="c">
				<IRPYRawContainer type="e">
				</IRPYRawContainer>
			</Args>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">     //reset%0D
	_7841_Write(handle[0],0,0x01); %0D
	%0D
	//CONFIGURATION%0D
	//CAN A%0D
	_7841_Write(handle[0],30,0x00);%0D
	%0D
	_7841_Write(handle[0],31,0x00);%0D
%0D
	_7841_Write(handle[0],8,0xFA);%0D
	//config BTR  50 kbis/s%0D
	_7841_Write(handle[0],6,0x07); //modif%0D
	%0D
	_7841_Write(handle[0],7,0x5c); // modif%0D
%0D
	//Config du mask%0D
	_7841_Write(handle[0],5,0x00);%0D
	_7841_Write(handle[0],4,id_maq_pc); // modif%0D
%0D
	//CAN A%0D
	_7841_Write(handle[0],30,0x00);%0D
	%0D
	_7841_Write(handle[0],31,0x00);%0D
	//relancer la carte%0D
	_7841_Write(handle[0],0,0x00);   %0D
	                                 %0D
	_7841_Write(handle[0],1,0x04);%0D
	_7841_Write(handle[0],1,0x04);      %0D
	%0D
        %0D
        %0D
        </_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
		<IPrimitiveOperation type="e">
			<_id type="a">GUID 0813ba12-9318-4561-94c1-556f066e166d</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">recv_capteurs</_name>
			<_modifiedTimeWeak type="a">12.5.2025::11:51:1</_modifiedTimeWeak>
			<_modifiedTime type="a">12.5.2025::11:51:1</_modifiedTime>
			<_lastID type="a">2</_lastID>
			<_virtual type="a">1</_virtual>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">bool</_hname>
					<_hid type="a">GUID e6c263cc-4bc5-4a11-b32d-02148c93add0</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPrivate</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">if(((_7841_Read(handle[0],2))&amp;0x01)==1){%0D
		//printf(&quot;Dans le if \n&quot;);%0D
		octets_entree[0]=_7841_Read(handle[0],22);%0D
		octets_entree[1]=_7841_Read(handle[0],23);%0D
		octets_entree[2]=_7841_Read(handle[0],24);%0D
		%0D
		_7841_Write(handle[0],1,0x04);%0D
		%0D
		%0D
		//printf(&quot;Etat entrees\n\n&quot;);		%0D
		//printf(&quot;Debut cycle A :  %25d\n&quot;,trame_entree[0]&amp;0x01);		%0D
		capteurs-&gt;dca = octets_entree[0]&amp;0x01;%0D
		%0D
		//printf(&quot;Debut cycle B :  %25d\n&quot;,(trame_entree[0]&amp;0x02)/2);%0D
		capteurs-&gt;dcb = (octets_entree[0]&amp;0x02)/2;%0D
				%0D
		//printf(&quot;Debut tapis A :  %25d\n&quot;,(trame_entree[0]&amp;0x04)/4);%0D
		capteurs-&gt;deba = (octets_entree[0]&amp;0x04)/4;		%0D
				%0D
		//printf(&quot;Milieu tapis A :  %25d\n&quot;,(trame_entree[0]&amp;0x08)/8);%0D
		capteurs-&gt;mia = (octets_entree[0]&amp;0x08)/8;		%0D
		//if ((*entrees).Valeurs.mia==1) printf(&quot;#######      MIA        ###################### \n&quot;);%0D
				%0D
		//printf(&quot;Fin tapis A :  %25d\n&quot;,trame_entree[1]&amp;0x01);%0D
		capteurs-&gt;fina = octets_entree[1]&amp;0x01;		%0D
		%0D
		//printf(&quot;Debut tapis B :  %25d\n&quot;,(trame_entree[1]&amp;0x02)/2);%0D
		capteurs-&gt;debb = (octets_entree[1]&amp;0x02)/2;		%0D
		%0D
		//printf(&quot;Milieu Tapis B :  %25d\n&quot;,(trame_entree[1]&amp;0x04)/4);%0D
		capteurs-&gt;mib = (octets_entree[1]&amp;0x04)/4;		%0D
		%0D
		//printf(&quot;Fin tapis B :  %25d\n&quot;,(trame_entree[1]&amp;0x08)/8);%0D
		capteurs-&gt;finb = (octets_entree[1]&amp;0x08)/8;		%0D
		%0D
		//printf(&quot;Debut tapis C :  %25d\n&quot;,trame_entree[2]&amp;0x01);%0D
		capteurs-&gt;debc = octets_entree[2]&amp;0x01;		%0D
		%0D
		//printf(&quot;Fin tapis C :  %25d\n&quot;,(trame_entree[2]&amp;0x02)/2);%0D
		capteurs-&gt;finc = (octets_entree[2]&amp;0x02)/2;		%0D
		%0D
		//printf(&quot;Verin vers A :  %25d\n&quot;,(trame_entree[2]&amp;0x04)/4);%0D
		capteurs-&gt;versa = (octets_entree[2]&amp;0x04)/4;		%0D
		%0D
		//printf(&quot;Verin vers B :  %25d\n&quot;,(trame_entree[2]&amp;0x08)/8);%0D
	    capteurs-&gt;versb = (octets_entree[2]&amp;0x08)/8;	%0D
	    %0D
	    printf(&quot;\ndca=%25d deba=%25d mia=%25d fina=%25d\n&quot;, capteurs-&gt;dca, capteurs-&gt;deba, capteurs-&gt;mia, capteurs-&gt;fina);%0D
        printf(&quot;dcb=%25d debb=%25d mib=%25d finb=%25d\n&quot;, capteurs-&gt;dcb, capteurs-&gt;debb, capteurs-&gt;mib, capteurs-&gt;finb);%0D
        printf(&quot;debc=%25d finc=%25d versa=%25d versb=%25d \n&quot;, capteurs-&gt;debc, capteurs-&gt;finc, capteurs-&gt;versa, capteurs-&gt;versb);%0D
 	%0D
		%0D
				return(true);%0D
	}%0D
		else %0D
		    %0D
		return(false);  %0D
		%0D
		%0D
		</_bodyData>
			</IBody>
			</_itsBody>
