			<_name type="a">send_commandes</_name>
			<_modifiedTimeWeak type="a">12.4.2025::23:17:17</_modifiedTimeWeak>
			<_modifiedTime type="a">12.4.2025::23:17:17</_modifiedTime>
			<_lastID type="a">2</_lastID>
			<_virtual type="a">1</_virtual>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">bool</_hname>
					<_hid type="a">GUID e6c263cc-4bc5-4a11-b32d-02148c93add0</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">%0D
if (commandes.mava == 1 &amp;&amp; commandes.mara==1) {%0D
		printf(&quot;/!\\ deux commandes contradictoires : mava et mara a 1 !! \n&quot;);%0D
		return false;%0D
}%0D
%0D
if (commandes.mavb == 1 &amp;&amp; commandes.marb==1) {%0D
		printf(&quot;/!\\ deux commandes contradictoires : mavb et marb a 1 !! \n&quot;);%0D
		return false;%0D
}    		%0D
%0D
if (commandes.mavc == 1 &amp;&amp; commandes.marc==1) {%0D
		printf(&quot;/!\\ deux commandes contradictoires : mavc et marc a 1 !! \n&quot;);%0D
		return false;%0D
}    		%0D
%0D
printf(&quot;\n mava=%25d mara=%25d mavb=%25d marb=%25d mavc=%25d marc=%25d ev=%25d\n&quot;, %0D
    commandes.mava, commandes.mara, commandes.mavb, commandes.marb, commandes.mavc, commandes.marc, commandes.ev);%0D
    		%0D
//printf(&quot;sending (mava,mara,mavb,marb,mavc,marb,ev)=(%25d,%25d,%25d,%25d,%25d,%25d,%25d)...&quot;, bit[0],bit[1],bit[2],bit[3],bit[4],bit[5],bit[6]);%0D
        octet_sortie=commandes.mava+commandes.mara*2+commandes.mavb*4+commandes.marb*8+commandes.mavc*16+commandes.marc*32+commandes.ev*64;%0D
%0D
        while(((_7841_Read(handle[0],0x02))&amp;0x04)==0);%0D
//printf(&quot;OK\n&quot;);%0D
		_7841_Write(handle[0],10,id_maq_pc);%0D
		_7841_Write(handle[0],11,0x01);%0D
		_7841_Write(handle[0],12,octet_sortie);%0D
		_7841_Write(handle[0],1,0x01);%0D
		%0D
		return true;%0D
             </_bodyData>
			</IBody>
			</_itsBody>
