			<m_rpn type="p">
				<CGIText type="e">
					<m_str type="a">tm(100)/p_maq_sim.send_commandes(commandes);%0D
capteurs = p_maq_sim.read_capteurs();%0D
%0D
//Tapis A%0D
if(capteurs.deba == 1) MULTICAST_GEN(toTapis,evDEBA);%0D
if(capteurs.mia == 1) MULTICAST_GEN(toTapis,evMIA);%0D
if(capteurs.fina == 1) MULTICAST_GEN(toTapis,evFINA);%0D
if(capteurs.dca == 1) MULTICAST_GEN(toTapis,evDCA);%0D
%0D
//Tapis b%0D
if(capteurs.debb == 1) MULTICAST_GEN(toTapis,evDEBB);%0D
if(capteurs.mib == 1) MULTICAST_GEN(toTapis,evMIB);%0D
if(capteurs.finb == 1) MULTICAST_GEN(toTapis,evFINB);%0D
if(capteurs.dcb == 1) MULTICAST_GEN(toTapis,evDCB);%0D
%0D
//Griffe%0D
if(capteurs.versa == 1) MULTICAST_GEN(toTapis,evVERSA);%0D
if(capteurs.versb == 1) MULTICAST_GEN(toTapis,evVERSB);%0D
%0D
//TapisC%0D
if(capteurs.debc == 1) MULTICAST_GEN(toTapis,evDEBC);%0D
if(capteurs.finc == 1) MULTICAST_GEN(toTapis,evFINC);</m_str>
