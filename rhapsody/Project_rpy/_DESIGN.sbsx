			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">%0D
unsigned char commande=0x01;%0D
 %0D
   %0D
    // Initialisation de Winsock%0D
    if (WSAStartup(MAKEWORD(2, 2), &amp;wsa) != 0) {%0D
        printf(&quot;Erreur initialisation Winsock: %25d\n&quot;, WSAGetLastError());%0D
        return -1;%0D
    }%0D
    %0D
    // Cr%E9ation du socket%0D
    if ((sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)) == INVALID_SOCKET) {%0D
        printf(&quot;Erreur creation socket: %25d\n&quot;, WSAGetLastError());%0D
        WSACleanup();%0D
        return -1;%0D
    }%0D
    %0D
    // Configuration du timeout de r%E9ception%0D
    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, (char*)&amp;timeout, sizeof(timeout));%0D
    %0D
    // Configuration de l'adresse du serveur%0D
    serveur.sin_family = AF_INET;%0D
    serveur.sin_port = htons(_PORT_MAQ_SIM);%0D
    serveur.sin_addr.s_addr = inet_addr(_IP_MAQ_SIM); %0D
    //InetPton(AF_INET, _IP_MAQ_SIM, &amp;(serveur.sin_addr));%0D
    %0D
    %0D
    connected = true;%0D
    reset_commandes();%0D
    return 1;</_bodyData>
			</IBody>
			</_itsBody>
