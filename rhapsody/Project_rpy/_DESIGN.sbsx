			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">unsigned char commande_inline;%0D
%0D
commandes.reserved=0;%0D
if (commandes.mava == 1 &amp;&amp; commandes.mara==1) {%0D
		printf(&quot;/!\\ deux commandes contradictoires : mava et mara a 1 !! \n&quot;);%0D
		return false;%0D
}%0D
%0D
if (commandes.mavb == 1 &amp;&amp; commandes.marb == 1) {%0D
		printf(&quot;/!\\ deux commandes contradictoires : mavb et marb a 1 !! \n&quot;);%0D
		return false;%0D
}    		%0D
%0D
if (commandes.mavc == 1 &amp;&amp; commandes.marc==1) {%0D
		printf(&quot;/!\\ deux commandes contradictoires : mavc et marc a 1 !! \n&quot;);%0D
		return false;%0D
}    		%0D
%0D
    		%0D
memcpy(&amp;commande_inline, &amp;commandes, 1);%0D
%0D
// Envoi de la commande%0D
   int  resultat = sendto(sock, (const char*)&amp;commande_inline, sizeof(commande_inline), 0,%0D
                     (struct sockaddr*)&amp;serveur, sizeof(serveur));%0D
    %0D
    if (resultat == SOCKET_ERROR) {%0D
        printf(&quot;Erreur envoi UDP: %25d\n&quot;, WSAGetLastError());%0D
        closesocket(sock);%0D
        WSACleanup();%0D
        return false;%0D
    }%0D
    %0D
    //printf(&quot;Commande envoyee: 0x%2502X\n&quot;, commande_inline);%0D
    printf(&quot;\n mava=%25d mara=%25d mavb=%25d marb=%25d mavc=%25d marc=%25d ev=%25d\n&quot;, %0D
    commandes.mava, commandes.mara, commandes.mavb, commandes.marb, commandes.mavc, commandes.marc, commandes.ev);%0D
    %0D
    // R%E9ception de la r%E9ponse %0D
    from_len = sizeof(from);%0D
    resultat = recvfrom(sock, buffer, sizeof(buffer), 0, %0D
                       (struct sockaddr*)&amp;from, &amp;from_len);%0D
    %0D
    if (resultat == SOCKET_ERROR) {%0D
        int error = WSAGetLastError();%0D
        if (error == WSAETIMEDOUT) {%0D
            printf(&quot;Timeout: aucune reponse recue du serveur\n&quot;);%0D
        } else {%0D
            printf(&quot;Erreur reception UDP: %25d\n&quot;, error);%0D
        }%0D
        closesocket(sock);%0D
        WSACleanup();%0D
        return false;%0D
    }%0D
        %0D
     unsigned char octet1 = (unsigned char)buffer[0];%0D
     unsigned char octet2 = (unsigned char)buffer[1];%0D
     unsigned char octet3 = (unsigned char)buffer[2];%0D
     %0D
     buf_capteurs[0] = octet1;%0D
	 buf_capteurs[1] = octet2;%0D
     buf_capteurs[2] = octet3;%0D
          %0D
%0D
     if ((octet1 &amp; 0xF0) == 0 &amp;&amp; (octet2 &amp; 0xF0) == 0 &amp;&amp; (octet3 &amp; 0xF0) == 0) {    %0D
        memcpy(&amp;capteurs, buf_capteurs, 3);%0D
        printf(&quot;\ndca=%25d deba=%25d mia=%25d fina=%25d\n&quot;, capteurs.dca, capteurs.deba, capteurs.mia, capteurs.fina);%0D
        printf(&quot;dcb=%25d debb=%25d mib=%25d finb=%25d\n&quot;, capteurs.dcb, capteurs.debb, capteurs.mib, capteurs.finb);%0D
        printf(&quot;debc=%25d finc=%25d\n&quot;, capteurs.debc, capteurs.finc);%0D
  %0D
     }%0D
     %0D
   return true;%0D
     </_bodyData>
			</IBody>
			</_itsBody>
