			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">printf (&quot;TAPIS SIM : reset commandes...\n&quot;);%0D
%0D
	commandes.mava = 0; %0D
	commandes.mara = 0; %0D
%0D
	commandes.mavb = 0; %0D
	commandes.marb = 0; %0D
	%0D
	commandes.mavc = 0; %0D
	commandes.marc = 0; %0D
%0D
    commandes.ev = 0; %0D
    %0D
    send_commandes(commandes);%0D
%0D
</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
